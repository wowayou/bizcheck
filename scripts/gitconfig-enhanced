# Git配置增强
# 复制到 ~/.gitconfig 或运行 git config --global --add ...

[alias]
    # === 状态查看 ===
    st = status --short --branch
    s = status

    # === 日志查看 ===
    lg = log --graph --oneline --decorate --all -15
    ll = log --graph --pretty=format:'%C(yellow)%h%C(reset) - %C(cyan)%an%C(reset) %C(green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n          %s' --abbrev-commit -15

    # === 分支管理 ===
    br = branch -vv
    bra = branch -a -vv

    # === 差异查看 ===
    staged = diff --cached
    unstaged = diff
    changed = diff HEAD

    # === 快速操作 ===
    co = checkout
    cob = checkout -b
    cm = commit -m
    ca = commit --amend
    can = commit --amend --no-edit

    # === 暂存操作 ===
    a = add
    aa = add --all
    ap = add --patch

    # === 撤销操作 ===
    unstage = reset HEAD --
    undo = reset --soft HEAD^

    # === 查看贡献 ===
    contributors = shortlog -sn --all --no-merges

[core]
    # 编辑器（可选，改成你喜欢的）
    editor = nano

    # 忽略文件权限变更（WSL2推荐）
    filemode = false

[pull]
    # 拉取时使用rebase而非merge（保持历史整洁）
    rebase = true

[init]
    # 默认分支名
    defaultBranch = main

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = green
    changed = yellow
    untracked = red

# 如果安装了delta，取消下面的注释
# [core]
#     pager = delta
#
# [interactive]
#     diffFilter = delta --color-only
#
# [delta]
#     navigate = true
#     side-by-side = false
#     line-numbers = true
#     syntax-theme = Dracula
